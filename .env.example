RASTRO_OPENAPI_ENABLED=1

RASTRO_POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

RASTRO_ZEROMQ_PUBLISH_ADDRESS=tcp://127.0.0.1:5555
RASTRO_ZEROMQ_SUBSCRIBE_ADDRESS=tcp://127.0.0.1:5555

RASTRO_SERVICE_NAMESPACE=rastro
RASTRO_SERVICE_NAME=rastro
RASTRO_DEPLOYMENT_ID=2f92ca37
RASTRO_DEPLOYMENT_ENVIRONMENT=dev
RASTRO_OTEL_GRPC_ENDPOINT=localhost:4317

RASTRO_SESSION_LIFETIME=P14D
RASTRO_SESSION_COOKIE_NAME=rastro_session
RASTRO_SESSION_COOKIE_SECURE=1
RASTRO_SESSION_COOKIE_HTTPONLY=1
RASTRO_SESSION_COOKIE_SAMESITE=lax
RASTRO_SESSION_TOKEN_BYTES=32

RASTRO_CSRF_COOKIE_NAME=rastro_csrf
RASTRO_CSRF_COOKIE_SECURE=1
RASTRO_CSRF_COOKIE_HTTPONLY=0
RASTRO_CSRF_COOKIE_SAMESITE=lax
RASTRO_CSRF_TOKEN_BYTES=32
RASTRO_CSRF_HEADER_NAME=X-CSRF-Token
