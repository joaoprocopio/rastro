  {
   "id": "rastro-evento-343",
   "type": "text",
   "x": 5360,
   "y": 650,
   "width": 643.3199999999999,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
