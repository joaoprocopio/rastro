   "versionNonce": 343,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ao clicar em \"Criar evento\" sem o obrigatório:\no que falta fica vermelho, com o motivo embaixo, e o foco vai para o 1º campo.\nO modal não fecha e nada do que foi digitado se perde.\nNão usamos toast (o Linear usa): o erro fica ao lado do campo.",
   "originalText": "Ao clicar em \"Criar evento\" sem o obrigatório:\no que falta fica vermelho, com o motivo embaixo, e o foco vai para o 1º campo.\nO modal não fecha e nada do que foi digitado se perde.\nNão usamos toast (o Linear usa): o erro fica ao lado do campo.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
