  {
   "id": "rastro-form-511",
   "type": "text",
   "x": 3400,
   "y": 2570,
   "width": 396.18000000000023,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
