   "versionNonce": 92,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Lista plana, sem cabeçalho de tabela. A linha diz: nome, atributos, tipo,\ngrupos que respondem e respostas recebidas. Clique na linha abre o editor.\nO aviso amarelo aparece só quando um grupo do evento não tem formulário.",
   "originalText": "Lista plana, sem cabeçalho de tabela. A linha diz: nome, atributos, tipo,\ngrupos que respondem e respostas recebidas. Clique na linha abre o editor.\nO aviso amarelo aparece só quando um grupo do evento não tem formulário.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
