  {
   "id": "rastro-form-1016",
   "type": "text",
   "x": 1000,
   "y": 4620,
   "width": 338.9400000000001,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
