  {
   "id": "rastro-estados-310",
   "type": "text",
   "x": 3360,
   "y": 2200,
   "width": 808.5599999999993,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
