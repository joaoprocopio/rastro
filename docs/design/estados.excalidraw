  {
   "id": "rastro-estados-97",
   "type": "text",
   "x": 410,
   "y": 960,
   "width": 1114.5599999999981,
   "height": 67.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
