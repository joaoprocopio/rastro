  {
   "id": "rastro-svc321",
   "type": "text",
   "x": 2840,
   "y": 740,
   "width": 995.2199999999988,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
