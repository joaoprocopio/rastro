  {
   "id": "rastro-svc1159",
   "type": "text",
   "x": 5940,
   "y": 2600,
   "width": 367.20000000000016,
   "height": 270.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
