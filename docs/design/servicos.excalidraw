  {
   "id": "rastro-svc835",
   "type": "text",
   "x": 1490,
   "y": 2380,
   "width": 334.44000000000017,
   "height": 67.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
