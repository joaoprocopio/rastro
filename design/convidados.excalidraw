  {
   "id": "rastro-cv4341",
   "type": "text",
   "x": 978,
   "y": 12465,
   "width": 809.2799999999993,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
