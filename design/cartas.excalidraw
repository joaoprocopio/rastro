  {
   "id": "rastro-cartas-2",
   "type": "text",
   "x": 0,
   "y": -686,
   "width": 1727.0000000000045,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
