  },
  {
   "id": "pe153",
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 153,
   "version": 1,
   "versionNonce": 153,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 354,
   "y": 4526,
   "width": 930.6,
   "height": 135,
   "text": "\u2699 abre as op\u00e7\u00f5es de exibi\u00e7\u00e3o do Linear.\nHeader e p\u00edlulas do Linear. + Novo evento fica no header.\nTabela como Members do Linear: cabe\u00e7alho de colunas, sem bordas, linhas de 2 n\u00edveis.\nGrupos por m\u00eas como os grupos de status das Issues do Linear: \u25be recolhe, + cria evento no m\u00eas.\nBarra de convidados: \u25a0 confirmados \u25a0 recusaram \u25a0 aguardando resposta \u25a1 n\u00e3o convidados.\nA linha inteira abre o evento. \u22ef aparece ao passar o mouse.",
   "originalText": "\u2699 abre as op\u00e7\u00f5es de exibi\u00e7\u00e3o do Linear.\nHeader e p\u00edlulas do Linear. + Novo evento fica no header.\nTabela como Members do Linear: cabe\u00e7alho de colunas, sem bordas, linhas de 2 n\u00edveis.\nGrupos por m\u00eas como os grupos de status das Issues do Linear: \u25be recolhe, + cria evento no m\u00eas.\nBarra de convidados: \u25a0 confirmados \u25a0 recusaram \u25a0 aguardando resposta \u25a1 n\u00e3o convidados.\nA linha inteira abre o evento. \u22ef aparece ao passar o mouse.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
